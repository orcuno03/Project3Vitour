@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Bir hata oluştu</h1>
<p class="text-muted">İsteğiniz işlenirken beklenmeyen bir hata meydana geldi. Lütfen tekrar deneyin.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek numarası:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="btn btn-primary" asp-controller="Tour" asp-action="TourList">Tur listesine dön</a>
