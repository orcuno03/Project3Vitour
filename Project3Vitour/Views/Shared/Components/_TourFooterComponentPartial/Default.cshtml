@model List<ResultCategoryDto>

<footer class="footer footer-style1">
    <div class="tf-container">
        <div class="footer-main">
            <div class="footer-logo">
                <div class="logo-footer">
                    <img src="/vitour/assets/images/logo2.png" alt="Vitour">
                </div>
                <p class="des-footer">@L["Footer_About"]</p>
                <ul class="footer-info">
                    <li class="flex-three">
                        <i class="icon-noun-mail-5780740-1"></i>
                        <p>info@vitour.com</p>
                    </li>
                    <li class="flex-three">
                        <i class="icon-Group-9"></i>
                        <p>+90 212 555 01 02</p>
                    </li>
                    <li class="flex-three">
                        <i class="icon-Layer-19"></i>
                        <p>Bağdat Caddesi No:123 Kadıköy / İstanbul</p>
                    </li>
                </ul>
            </div>
            <div class="footer-service">
                <h5 class="title">@L["Footer_QuickLinks"]</h5>

                <ul class="footer-menu">
                    <li>
                        <a asp-controller="Tour" asp-action="TourList">@L["Nav_Home"]</a>
                    </li>
                    <li>
                        <a asp-controller="Tour" asp-action="TourList">@L["Nav_AllTours"]</a>
                    </li>
                </ul>
            </div>
            <div class="footer-service">
                <h5 class="title">@L["Footer_Categories"]</h5>

                <ul class="footer-menu">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var kategori in Model)
                        {
                            <li>
                                <a asp-controller="Tour" asp-action="TourList"
                                   asp-route-categoryId="@kategori.CategoryId">@(L[kategori.CategoryName]?.Value ?? kategori.CategoryName)</a>
                            </li>
                        }
                    }
                </ul>
            </div>
            <div class="footer-gallery">
                <h5 class="title">@L["Footer_Gallery"]</h5>

                <div class="gallery-img">
                    <a href="/vitour/assets/images/tours/kapadokya.jpg" data-fancybox="gallery">
                        <img src="/vitour/assets/images/tours/kapadokya.jpg" alt="Kapadokya">
                    </a>
                    <a href="/vitour/assets/images/tours/istanbul.jpg" data-fancybox="gallery">
                        <img src="/vitour/assets/images/tours/istanbul.jpg" alt="İstanbul">
                    </a>
                    <a href="/vitour/assets/images/tours/fethiye.jpg" data-fancybox="gallery">
                        <img src="/vitour/assets/images/tours/fethiye.jpg" alt="Fethiye">
                    </a>
                    <a href="/vitour/assets/images/tours/kas.jpg" data-fancybox="gallery">
                        <img src="/vitour/assets/images/tours/kas.jpg" alt="Kaş">
                    </a>
                    <a href="/vitour/assets/images/tours/kars.jpg" data-fancybox="gallery">
                        <img src="/vitour/assets/images/tours/kars.jpg" alt="Kars">
                    </a>
                    <a href="/vitour/assets/images/tours/uludag.jpg" data-fancybox="gallery">
                        <img src="/vitour/assets/images/tours/uludag.jpg" alt="Uludağ">
                    </a>
                </div>
            </div>
        </div>

        <div class="row footer-bottom">
            <div class="col-md-6">
                <p class="copy-right">&copy; @DateTime.Now.Year Vitour. @L["Footer_Rights"]</p>
            </div>
            <div class="col-md-6">
                <ul class="social flex-six">
                    <li>
                        <a href="#">
                            <i class="icon-icon-2"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="icon-x"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="icon-icon_03"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="icon-2"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</footer>
