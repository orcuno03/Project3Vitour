
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vitour @L["Panel_Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@600&display=swap" rel="stylesheet" />
    
    <!-- DataTables & SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <style>
        /* Degiskenler */
        :root {
            --sidebar-w: 260px;
            --sidebar-collapsed-w: 72px;
            --navy: #0d1b2a;
            --navy-mid: #112240;
            --navy-lite: #1a3358;
            --accent: #2d9cdb;
            --accent-dk: #1a7ab5;
            --surface: #f4f6fb;
            --white: #ffffff;
            --border: #e2e8f0;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --sidebar-transition: 0.28s cubic-bezier(.4,0,.2,1);
            --shadow-sm: 0 1px 3px rgba(0,0,0,.07), 0 1px 2px rgba(0,0,0,.05);
            --shadow-md: 0 4px 16px rgba(13,27,42,.10);
            --shadow-lg: 0 10px 40px rgba(13,27,42,.14);
        }

        /* Temel */
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--surface);
            color: var(--text-main);
            margin: 0;
            min-height: 100vh;
            display: flex;
        }

        a {
            text-decoration: none;
        }

        /* Kenar cubugu */
        #sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: var(--sidebar-w);
            background: var(--navy);
            display: flex;
            flex-direction: column;
            z-index: 1050;
            transition: width var(--sidebar-transition);
            overflow: hidden;
        }

            #sidebar.collapsed {
                width: var(--sidebar-collapsed-w);
            }

        /* Marka */
        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 20px 20px 18px;
            border-bottom: 1px solid rgba(255,255,255,.07);
            min-height: 70px;
            overflow: hidden;
            white-space: nowrap;
        }

        .brand-icon {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            background: var(--accent);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #fff;
            box-shadow: 0 2px 8px rgba(45,156,219,.4);
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            opacity: 1;
            transition: opacity .2s;
        }

        .brand-name {
            font-family: 'Playfair Display', serif;
            font-size: 17px;
            color: #fff;
            line-height: 1.2;
        }

        .brand-sub {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,.4);
        }

        #sidebar.collapsed .brand-text {
            opacity: 0;
            pointer-events: none;
        }

        /* Menu */
        .sidebar-nav {
            flex: 1;
            padding: 12px 0;
            overflow-y: auto;
            overflow-x: hidden;
        }

            .sidebar-nav::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-nav::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar-nav::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.12);
                border-radius: 4px;
            }

        .nav-section-label {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.6px;
            color: rgba(255,255,255,.3);
            padding: 14px 22px 6px;
            white-space: nowrap;
            overflow: hidden;
            transition: opacity .2s;
        }

        #sidebar.collapsed .nav-section-label {
            opacity: 0;
        }

        .nav-item-link {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 11px 22px;
            color: rgba(255,255,255,.65);
            font-size: 14px;
            font-weight: 500;
            white-space: nowrap;
            border-radius: 0;
            transition: background .18s, color .18s, padding .28s;
            position: relative;
            overflow: hidden;
        }

            .nav-item-link i {
                flex-shrink: 0;
                font-size: 17px;
                width: 22px;
                text-align: center;
                transition: transform .2s;
            }

            .nav-item-link:hover {
                background: rgba(255,255,255,.07);
                color: #fff;
            }

                .nav-item-link:hover i {
                    transform: translateX(2px);
                }

            .nav-item-link.active {
                background: var(--accent);
                color: #fff;
                box-shadow: inset 4px 0 0 rgba(255,255,255,.3);
            }

                .nav-item-link.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    width: 3px;
                    height: 100%;
                    background: #fff;
                    border-radius: 0 3px 3px 0;
                }

        .nav-label {
            transition: opacity .2s, width .28s;
        }

        #sidebar.collapsed .nav-label {
            opacity: 0;
            width: 0;
            overflow: hidden;
        }

        /* Ana govde */
        #main-wrapper {
            margin-left: var(--sidebar-w);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            transition: margin-left var(--sidebar-transition);
        }

            #main-wrapper.expanded {
                margin-left: var(--sidebar-collapsed-w);
            }

        /* Ust cubuk */
        #topbar {
            position: sticky;
            top: 0;
            z-index: 1040;
            height: 70px;
            background: var(--white);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 24px;
            gap: 16px;
            box-shadow: var(--shadow-sm);
        }

        .btn-toggle-sidebar {
            background: none;
            border: 1px solid var(--border);
            border-radius: 8px;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            cursor: pointer;
            transition: background .15s, color .15s;
            flex-shrink: 0;
        }

            .btn-toggle-sidebar:hover {
                background: var(--surface);
                color: var(--navy);
            }

        .topbar-search {
            flex: 1;
            max-width: 380px;
            position: relative;
        }

            .topbar-search input {
                width: 100%;
                padding: 9px 16px 9px 40px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: var(--surface);
                font-family: 'DM Sans', sans-serif;
                font-size: 13.5px;
                color: var(--text-main);
                transition: border-color .15s, box-shadow .15s;
                outline: none;
            }

                .topbar-search input:focus {
                    border-color: var(--accent);
                    box-shadow: 0 0 0 3px rgba(45,156,219,.15);
                    background: #fff;
                }

            .topbar-search .search-icon {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 15px;
                pointer-events: none;
            }

        .topbar-actions {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .topbar-icon-btn {
            width: 40px;
            height: 40px;
            border: none;
            border-radius: 10px;
            background: none;
            color: var(--text-muted);
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
            transition: background .15s, color .15s;
        }

            .topbar-icon-btn:hover {
                background: var(--surface);
                color: var(--navy);
            }

        .notif-badge {
            position: absolute;
            top: 7px;
            right: 7px;
            width: 8px;
            height: 8px;
            background: var(--danger);
            border-radius: 50%;
            border: 2px solid #fff;
        }

        .topbar-divider {
            width: 1px;
            height: 28px;
            background: var(--border);
            margin: 0 6px;
        }

        .admin-profile-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 10px 6px 6px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: none;
        }

        .admin-avatar {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--accent), var(--navy-lite));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
        }

        .admin-info {
            text-align: left;
        }

        .admin-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-main);
            line-height: 1.2;
        }

        .admin-role {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* Icerik alani */
        #content-area {
            flex: 1;
            padding: 28px 28px 40px;
        }

        /* Sayfa basligi */
        .page-header {
            margin-bottom: 24px;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            color: var(--navy);
            margin: 0 0 4px;
        }

        .breadcrumb {
            font-size: 12.5px;
            margin: 0;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            color: var(--text-muted);
        }

        /* Mobil */
        @@media (max-width: 991.98px) {
            #sidebar

        {
            transform: translateX(-100%);
            transition: transform var(--sidebar-transition), width var(--sidebar-transition);
        }

        #sidebar.mobile-open {
            transform: translateX(0);
            width: var(--sidebar-w) !important;
        }

        #main-wrapper {
            margin-left: 0 !important;
        }

        #sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 1049;
        }

            #sidebar-backdrop.show {
                display: block;
            }

        }

        /* Ortak admin bilesenleri: tum modul ekranlari bu siniflari kullanir. */

        /* Sayfa basligi + sag taraftaki aksiyon butonu */
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 22px;
            flex-wrap: wrap;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            color: var(--navy);
            margin: 0 0 3px;
        }

        .section-sub {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0;
        }

        /* Kart */
        .admin-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .admin-card-body {
            padding: 22px;
        }

        /* Tablo */
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13.5px;
        }

            .admin-table thead th {
                background: var(--surface);
                color: var(--text-muted);
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .8px;
                padding: 13px 16px;
                text-align: left;
                border-bottom: 1px solid var(--border);
                white-space: nowrap;
            }

            .admin-table tbody td {
                padding: 13px 16px;
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
                color: var(--text-main);
            }

            .admin-table tbody tr:last-child td {
                border-bottom: none;
            }

            .admin-table tbody tr:hover {
                background: #fafbfe;
            }

        .table-scroll {
            overflow-x: auto;
        }

        .cell-title {
            font-weight: 600;
            color: var(--navy);
        }

        .cell-muted {
            color: var(--text-muted);
            font-size: 12.5px;
        }

        .thumb {
            width: 54px;
            height: 40px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface);
        }

        /* Rozetler */
        .badge-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 600;
            white-space: nowrap;
        }

        .badge-success {
            background: #e8f8f2;
            color: #0f7a58;
        }

        .badge-danger {
            background: #fdecec;
            color: #c23434;
        }

        .badge-warning {
            background: #fef4e6;
            color: #b57314;
        }

        .badge-neutral {
            background: var(--surface);
            color: var(--text-muted);
        }

        .badge-info {
            background: #e8f3fb;
            color: var(--accent-dk);
        }

        /* Butonlar */
        .btn-admin {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: none;
            border-radius: 10px;
            padding: 10px 18px;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: background .18s, transform .15s, box-shadow .18s;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-primary-admin {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 2px 10px rgba(45,156,219,.35);
        }

            .btn-primary-admin:hover {
                background: var(--accent-dk);
                color: #fff;
                transform: translateY(-1px);
            }

        .btn-ghost-admin {
            background: var(--surface);
            color: var(--text-main);
            border: 1px solid var(--border);
        }

            .btn-ghost-admin:hover {
                background: #e9edf5;
                color: var(--navy);
            }

        /* Tablo satir aksiyonlari */
        .row-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: var(--white);
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            cursor: pointer;
            transition: background .15s, color .15s, border-color .15s;
            text-decoration: none;
        }

            .btn-icon:hover {
                background: var(--surface);
                color: var(--navy);
            }

            .btn-icon.edit:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

            .btn-icon.delete:hover {
                border-color: var(--danger);
                color: var(--danger);
            }

            .btn-icon.approve:hover {
                border-color: var(--success);
                color: var(--success);
            }

            .btn-icon.excel:hover {
                border-color: var(--success);
                color: var(--success);
            }

            .btn-icon.pdf:hover {
                border-color: var(--danger);
                color: var(--danger);
            }

        /* Form */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .form-group-admin {
            display: flex;
            flex-direction: column;
        }

            .form-group-admin.full {
                grid-column: 1 / -1;
            }

        .form-label-admin {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 7px;
        }

        .form-control-admin {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--white);
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            color: var(--text-main);
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .form-control-admin:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(45,156,219,.15);
            }

        textarea.form-control-admin {
            min-height: 110px;
            resize: vertical;
        }

        .form-actions {
            display: flex;
            gap: 10px;
            margin-top: 22px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
        }

        .validation-msg {
            color: var(--danger);
            font-size: 12px;
            margin-top: 5px;
        }

        /* Switch (durum) */
        .switch-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-check-input:checked {
            background-color: var(--accent);
            border-color: var(--accent);
        }

        /* Bos durum */
        .empty-state-admin {
            padding: 60px 20px;
            text-align: center;
            color: var(--text-muted);
        }

            .empty-state-admin i {
                font-size: 42px;
                color: #cbd5e1;
                display: block;
                margin-bottom: 12px;
            }

        @@media (max-width: 767.98px) {
            .form-grid

        {
            grid-template-columns: 1fr;
        }

        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Kenar cubugu -->
    <aside id="sidebar">
        <!-- Marka -->
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-compass"></i></div>
            <div class="brand-text">
                <span class="brand-name">Vitour</span>
                <span class="brand-sub">@L["Panel_Title"]</span>
            </div>
        </div>

        <!-- Menu -->
        @{
            var aktifController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            string Aktif(string controller) => aktifController == controller ? "active" : "";
        }

        <nav class="sidebar-nav">
            <div class="nav-section-label">@L["Menu_ContentManagement"]</div>

            <a asp-controller="AdminDashboard" asp-action="Index" class="nav-item-link @Aktif("AdminDashboard")" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                <i class="bi bi-speedometer2"></i>
                <span class="nav-label">Dashboard / İstatistik</span>
            </a>

            <a asp-controller="AdminTour" asp-action="TourList" class="nav-item-link @Aktif("AdminTour")" data-bs-toggle="tooltip" data-bs-placement="right" title="@L["Menu_Tours"]">
                <i class="bi bi-map-fill"></i>
                <span class="nav-label">@L["Menu_Tours"]</span>
            </a>

            <a asp-controller="AdminCategory" asp-action="CategoryList" class="nav-item-link @Aktif("AdminCategory")" data-bs-toggle="tooltip" data-bs-placement="right" title="@L["Menu_Categories"]">
                <i class="bi bi-tags-fill"></i>
                <span class="nav-label">@L["Menu_Categories"]</span>
            </a>

            <a asp-controller="AdminDestination" asp-action="DestinationList" class="nav-item-link @Aktif("AdminDestination")" data-bs-toggle="tooltip" data-bs-placement="right" title="@L["Menu_Destinations"]">
                <i class="bi bi-geo-alt-fill"></i>
                <span class="nav-label">@L["Menu_Destinations"]</span>
            </a>

            <a asp-controller="AdminTourPlan" asp-action="TourPlanList" class="nav-item-link @Aktif("AdminTourPlan")" data-bs-toggle="tooltip" data-bs-placement="right" title="@L["Menu_TourPlans"]">
                <i class="bi bi-calendar3-week-fill"></i>
                <span class="nav-label">@L["Menu_TourPlans"]</span>
            </a>

            <a asp-controller="AdminTourImage" asp-action="TourImageList" class="nav-item-link @Aktif("AdminTourImage")" data-bs-toggle="tooltip" data-bs-placement="right" title="@L["Menu_TourImages"]">
                <i class="bi bi-images"></i>
                <span class="nav-label">@L["Menu_TourImages"]</span>
            </a>

            <div class="nav-section-label">@L["Menu_Operations"]</div>

            <a asp-controller="AdminReservation" asp-action="ReservationList" class="nav-item-link @Aktif("AdminReservation")" data-bs-toggle="tooltip" data-bs-placement="right" title="@L["Menu_Reservations"]">
                <i class="bi bi-calendar2-check-fill"></i>
                <span class="nav-label">@L["Menu_Reservations"]</span>
            </a>

            <a asp-controller="AdminReview" asp-action="ReviewList" class="nav-item-link @Aktif("AdminReview")" data-bs-toggle="tooltip" data-bs-placement="right" title="@L["Menu_Reviews"]">
                <i class="bi bi-chat-heart-fill"></i>
                <span class="nav-label">@L["Menu_Reviews"]</span>
            </a>

            <div class="nav-section-label">@L["Menu_Site"]</div>

            <a asp-controller="Tour" asp-action="TourList" class="nav-item-link" data-bs-toggle="tooltip" data-bs-placement="right" title="@L["Menu_ViewSite"]">
                <i class="bi bi-box-arrow-up-right"></i>
                <span class="nav-label">@L["Menu_ViewSite"]</span>
            </a>
        </nav>
    </aside>

    <!-- Mobil arka plan -->
    <div id="sidebar-backdrop"></div>

    <div id="main-wrapper">

        <!-- Ust cubuk -->
        <header id="topbar">
            <!-- Menu ac/kapa -->
            <button class="btn-toggle-sidebar" id="btnToggleSidebar" aria-label="Menüyü aç/kapat">
                <i class="bi bi-layout-sidebar-inset"></i>
            </button>

            <!-- Arama -->
            <div class="topbar-search d-none d-md-block">
                <i class="bi bi-search search-icon"></i>
                <input type="text" placeholder="@L["Topbar_Search"]" />
            </div>

            <!-- Sag aksiyonlar -->
            <div class="topbar-actions">
                <!-- Arama (mobil) -->
                <button class="topbar-icon-btn d-md-none" aria-label="@L["Topbar_Search"]">
                    <i class="bi bi-search"></i>
                </button>

                <!-- Bildirimler -->
                <button class="topbar-icon-btn" aria-label="Bildirim">
                    <i class="bi bi-bell-fill"></i>
                    <span class="notif-badge"></span>
                </button>

                @* Dil secici (cookie tabanli) *@
                @{
                    var mevcutDil = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                    var buSayfa = ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString;
                }

                <div class="dropdown">
                    <button class="topbar-icon-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                            style="width:auto; gap:6px; padding:0 10px; font-size:13px; font-weight:600;"
                            aria-label="@L["Topbar_Language"]">
                        <i class="bi bi-translate"></i>
                        <span>@mevcutDil.ToUpper()</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end mt-1" style="min-width:150px; border-radius:12px; border-color:var(--border); box-shadow:var(--shadow-md);">
                        <li>
                            <a class="dropdown-item @(mevcutDil == "tr" ? "active" : "")"
                               asp-controller="Language" asp-action="ChangeLanguage"
                               asp-route-culture="tr" asp-route-returnUrl="@buSayfa">
                                Türkçe
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(mevcutDil == "en" ? "active" : "")"
                               asp-controller="Language" asp-action="ChangeLanguage"
                               asp-route-culture="en" asp-route-returnUrl="@buSayfa">
                                English
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="topbar-divider d-none d-sm-block"></div>

                <!-- Yonetici gostergesi -->
                <div class="admin-profile-btn">
                    <div class="admin-avatar">Y</div>
                    <div class="admin-info d-none d-sm-block">
                        <div class="admin-name">@L["Topbar_Admin"]</div>
                        <div class="admin-role">@L["Topbar_SuperAdmin"]</div>
                    </div>
                </div>
            </div>
        </header>

        <main id="content-area">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const sidebar   = document.getElementById('sidebar');
        const wrapper   = document.getElementById('main-wrapper');
        const backdrop  = document.getElementById('sidebar-backdrop');
        const btnToggle = document.getElementById('btnToggleSidebar');

        function isMobile() { return window.innerWidth < 992; }

        btnToggle.addEventListener('click', () => {
            if (isMobile()) {
                sidebar.classList.toggle('mobile-open');
                backdrop.classList.toggle('show');
            } else {
                sidebar.classList.toggle('collapsed');
                wrapper.classList.toggle('expanded');
                ipuclariniGuncelle();
            }
        });

        backdrop.addEventListener('click', () => {
            sidebar.classList.remove('mobile-open');
            backdrop.classList.remove('show');
        });

        const menuOgeleri = document.querySelectorAll('#sidebar [data-bs-toggle="tooltip"]');
        menuOgeleri.forEach(el => el.removeAttribute('data-bs-toggle'));

        let ipucuOrnekleri = [];

        function ipuclariniGuncelle() {
            ipucuOrnekleri.forEach(t => t.dispose());
            ipucuOrnekleri = [];

            if (sidebar.classList.contains('collapsed')) {
                menuOgeleri.forEach(el => {
                    ipucuOrnekleri.push(new bootstrap.Tooltip(el, { trigger: 'hover', placement: 'right' }));
                });
            }
        }

        // DataTables Otomatik Başlatma
        $(document).ready(function() {
            if ($('.admin-table').length > 0) {
                $('.admin-table').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json'
                    },
                    pageLength: 10,
                    responsive: true,
                    ordering: true
                });
            }
        });

        // SweetAlert2 Silme Onay Yardımcısı
        function confirmDelete(deleteUrl, title) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: (title ? '"' + title + '" silinecektir. ' : '') + 'Bu işlem geri alınamaz!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Evet, Sil!',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = deleteUrl;
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



