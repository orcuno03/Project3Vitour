@model List<ResultReservationDto>

@{
    ViewData["Title"] = "Rezervasyonlar";
    Layout = "~/Views/Shared/_TourLayout.cshtml";

    var tourTitles = ViewBag.TourTitles as Dictionary<string, string> ?? new Dictionary<string, string>();

    var onayBekleyen = Model.Count(x => x.ReservationStatus == ReservationStatuses.Pending);
    var toplamKisi = Model.Where(x => x.ReservationStatus != ReservationStatuses.Cancelled).Sum(x => x.PersonCount);
}

<div class="section-header">
    <div>
        <h1 class="section-title">Rezervasyonlar</h1>
        <p class="section-sub">
            @Model.Count rezervasyon · @toplamKisi kişi (iptaller hariç)
            @if (onayBekleyen > 0)
            {
                <span class="badge-pill badge-warning" style="margin-left:8px;">
                    <i class="bi bi-hourglass-split"></i> @onayBekleyen onay bekliyor
                </span>
            }
        </p>
    </div>
    <a asp-controller="AdminReservation" asp-action="CreateReservation" class="btn-admin btn-primary-admin">
        <i class="bi bi-plus-lg"></i> Yeni Rezervasyon
    </a>
</div>

<div class="admin-card">
    @if (!Model.Any())
    {
        <div class="empty-state-admin">
            <i class="bi bi-calendar2-check"></i>
            Henüz rezervasyon yapılmamış.
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Müşteri</th>
                        <th>Tur</th>
                        <th>İletişim</th>
                        <th style="width:80px;">Kişi</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th style="width:110px;">Rapor</th>
                        <th style="width:200px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(x => x.ReservationDate))
                    {
                        var turAdi = tourTitles.ContainsKey(item.TourId) ? tourTitles[item.TourId] : "Silinmiş tur";

                        <tr>
                            <td>
                                <div class="cell-title">@item.NameSurname</div>
                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <div class="cell-muted" style="font-size:11.5px;">
                                        <i class="bi bi-sticky"></i> @item.Note
                                    </div>
                                }
                            </td>
                            <td><span class="badge-pill badge-info"><i class="bi bi-map"></i> @turAdi</span></td>
                            <td class="cell-muted">
                                @item.Email<br />
                                @item.Phone
                            </td>
                            <td>
                                <span class="badge-pill badge-neutral"><i class="bi bi-people-fill"></i> @item.PersonCount</span>
                            </td>
                            <td class="cell-muted">@item.ReservationDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (item.ReservationStatus == ReservationStatuses.Approved)
                                {
                                    <span class="badge-pill badge-success"><i class="bi bi-check-circle-fill"></i> @item.ReservationStatus</span>
                                }
                                else if (item.ReservationStatus == ReservationStatuses.Cancelled)
                                {
                                    <span class="badge-pill badge-danger"><i class="bi bi-x-circle-fill"></i> @item.ReservationStatus</span>
                                }
                                else
                                {
                                    <span class="badge-pill badge-warning"><i class="bi bi-hourglass-split"></i> @item.ReservationStatus</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a asp-controller="AdminReservation" asp-action="ExportToExcel" asp-route-id="@item.TourId"
                                       class="btn-icon excel" title="@turAdi turuna kayıt olanları Excel indir">
                                        <i class="bi bi-file-earmark-excel"></i>
                                    </a>
                                    <a asp-controller="AdminReservation" asp-action="ExportToPdf" asp-route-id="@item.TourId"
                                       class="btn-icon pdf" title="@turAdi turuna kayıt olanları PDF indir">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </a>
                                </div>
                            </td>
                            <td>
                                <div class="row-actions">
                                    @if (item.ReservationStatus != ReservationStatuses.Approved)
                                    {
                                        <a asp-controller="AdminReservation" asp-action="ApproveReservation" asp-route-id="@item.ReservationId"
                                           class="btn-icon approve" title="Onayla">
                                            <i class="bi bi-check-lg"></i>
                                        </a>
                                    }
                                    @if (item.ReservationStatus != ReservationStatuses.Cancelled)
                                    {
                                        <a asp-controller="AdminReservation" asp-action="CancelReservation" asp-route-id="@item.ReservationId"
                                           class="btn-icon delete" title="İptal Et"
                                           onclick="return confirm('Bu rezervasyonu iptal etmek istediğinize emin misiniz?');">
                                            <i class="bi bi-x-lg"></i>
                                        </a>
                                    }
                                    <a asp-controller="AdminReservation" asp-action="UpdateReservation" asp-route-id="@item.ReservationId"
                                       class="btn-icon edit" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-controller="AdminReservation" asp-action="DeleteReservation" asp-route-id="@item.ReservationId"
                                       class="btn-icon delete" title="Sil"
                                       onclick="return confirm('Bu rezervasyonu kalıcı olarak silmek istediğinize emin misiniz?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
