@model Project3Vitour.Models.TourDetailViewModel

@{
    Layout = null;

    string Yildizlar(double puan)
    {
        var dolu = (int)Math.Round(puan);
        var sb = new System.Text.StringBuilder();
        for (int i = 1; i <= 5; i++)
            sb.Append(i <= dolu ? "<i class=\"td-star full\">&#9733;</i>" : "<i class=\"td-star\">&#9733;</i>");
        return sb.ToString();
    }

    // Rozet degeri DB'de Ingilizce tutuluyor; sadece taninan degerler ekrana basiliyor
    var rozetler = new[] { "Popular", "New", "Limited" };
    var rozet = Model.Tour.Badge;
    var rozetGecerli = !string.IsNullOrWhiteSpace(rozet) && rozetler.Contains(rozet, StringComparer.OrdinalIgnoreCase);
    var rozetAnahtar = rozetGecerli
        ? "Badge_" + char.ToUpperInvariant(rozet[0]) + rozet.Substring(1).ToLowerInvariant()
        : null;

    var yorumMesaji = TempData["ReviewMessage"] as string;
    var yorumHatasi = TempData["ReviewError"] as string;

    var haritaAlt = ((Model.DestinationName ?? string.Empty) + " " + L["Detail_LocationTitle"].Value).Trim();
    var dilKodu = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="@dilKodu">

@await Component.InvokeAsync("_TourHeadComponentPartial")

<body class="body header-fixed">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <div id="wrapper">
        <div id="pagee" class="clearfix">

            @await Component.InvokeAsync("_TourHeaderComponentPartial")

            <main id="main">

                <style>
                    .td-wrap {
                        max-width: 1180px;
                        margin: 0 auto;
                        padding: 40px 20px 70px;
                        font-family: 'DM Sans', sans-serif;
                        color: #1e293b;
                    }

                    /* Ust bolum */
                    .td-hero {
                        display: grid;
                        grid-template-columns: 1.6fr 1fr;
                        gap: 28px;
                        margin-bottom: 34px;
                    }

                    .td-cover-box {
                        position: relative;
                        width: 100%;
                        height: 380px;
                        border-radius: 18px;
                        overflow: hidden;
                        background: #eef2f6;
                    }

                        .td-cover-box img {
                            position: absolute;
                            inset: 0;
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                        }

                    .td-ph {
                        position: absolute;
                        inset: 0;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        color: #9fb0bf;
                        font-size: 38px;
                    }

                    .td-side {
                        background: #fff;
                        border: 1px solid #e2e8f0;
                        border-radius: 18px;
                        padding: 24px;
                        box-shadow: 0 4px 20px rgba(13,27,42,.06);
                        align-self: start;
                    }

                    .td-badge {
                        display: inline-block;
                        background: #e8f3fb;
                        color: #1a7ab5;
                        font-size: 12px;
                        font-weight: 700;
                        padding: 5px 12px;
                        border-radius: 20px;
                        margin-bottom: 10px;
                    }

                    .td-title {
                        font-size: 30px;
                        font-weight: 700;
                        line-height: 1.25;
                        margin: 0 0 10px;
                        color: #0d1b2a;
                    }

                    .td-loc {
                        color: #64748b;
                        font-size: 14px;
                        margin-bottom: 14px;
                    }

                    .td-rating {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        font-size: 14px;
                        color: #64748b;
                    }

                    .td-star {
                        color: #d5dee6;
                        font-style: normal;
                        font-size: 16px;
                    }

                        .td-star.full {
                            color: #f0b429;
                        }

                    .td-price {
                        font-size: 30px;
                        font-weight: 700;
                        color: #2d9cdb;
                        margin: 0 0 4px;
                    }

                    .td-price-sub {
                        font-size: 12.5px;
                        color: #94a3b8;
                        margin-bottom: 18px;
                    }

                    .td-facts {
                        list-style: none;
                        padding: 0;
                        margin: 0 0 18px;
                    }

                        .td-facts li {
                            display: flex;
                            justify-content: space-between;
                            padding: 10px 0;
                            border-bottom: 1px dashed #e9eef3;
                            font-size: 14px;
                        }

                            .td-facts li:last-child {
                                border-bottom: none;
                            }

                        .td-facts .lbl {
                            color: #64748b;
                        }

                        .td-facts .val {
                            font-weight: 600;
                            color: #0d1b2a;
                        }

                    .td-seats {
                        border-radius: 12px;
                        padding: 12px 14px;
                        font-size: 13.5px;
                        font-weight: 600;
                        text-align: center;
                    }

                    .td-seats-ok {
                        background: #e8f8f2;
                        color: #0f7a58;
                    }

                    .td-seats-full {
                        background: #fdecec;
                        color: #c23434;
                    }

                    .td-book {
                        display: block;
                        width: 100%;
                        text-align: center;
                        background: #2d9cdb;
                        color: #fff !important;
                        font-weight: 700;
                        font-size: 15px;
                        padding: 14px;
                        border-radius: 12px;
                        box-shadow: 0 6px 18px rgba(45,156,219,.35);
                        transition: background .18s, transform .15s;
                    }

                        .td-book:hover {
                            background: #1a7ab5;
                            transform: translateY(-1px);
                        }

                    /* Sekmeler */
                    .td-tabs {
                        display: flex;
                        gap: 6px;
                        border-bottom: 2px solid #e2e8f0;
                        margin-bottom: 26px;
                        flex-wrap: wrap;
                    }

                    .td-tab {
                        background: none;
                        border: none;
                        padding: 13px 20px;
                        font-family: 'DM Sans', sans-serif;
                        font-size: 14.5px;
                        font-weight: 600;
                        color: #64748b;
                        cursor: pointer;
                        border-bottom: 3px solid transparent;
                        margin-bottom: -2px;
                        transition: color .18s, border-color .18s;
                    }

                        .td-tab:hover {
                            color: #2d9cdb;
                        }

                        .td-tab.active {
                            color: #2d9cdb;
                            border-bottom-color: #2d9cdb;
                        }

                    .td-panel {
                        display: none;
                    }

                        .td-panel.active {
                            display: block;
                        }

                    .td-h3 {
                        font-size: 19px;
                        font-weight: 700;
                        color: #0d1b2a;
                        margin: 0 0 14px;
                    }

                    .td-text {
                        font-size: 15px;
                        line-height: 1.8;
                        color: #475569;
                    }

                    .td-infocards {
                        display: grid;
                        grid-template-columns: repeat(4, 1fr);
                        gap: 14px;
                        margin-top: 24px;
                    }

                    .td-infocard {
                        border: 1px solid #e6eef3;
                        border-radius: 14px;
                        padding: 16px 18px;
                        background: #f9fbfc;
                    }

                        .td-infocard i {
                            color: #2d9cdb;
                            font-size: 20px;
                        }

                        .td-infocard .lbl {
                            display: block;
                            font-size: 12.5px;
                            color: #64748b;
                            margin: 8px 0 2px;
                        }

                        .td-infocard .val {
                            font-size: 16px;
                            font-weight: 700;
                            color: #0d1b2a;
                        }

                    /* Program (gun gun) */
                    .td-day {
                        display: flex;
                        gap: 18px;
                        padding: 20px 0;
                        border-bottom: 1px solid #eef2f6;
                    }

                        .td-day:last-child {
                            border-bottom: none;
                        }

                    .td-day-num {
                        flex-shrink: 0;
                        width: 62px;
                        height: 62px;
                        border-radius: 14px;
                        background: linear-gradient(135deg, #2d9cdb, #1a3358);
                        color: #fff;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        font-weight: 700;
                        line-height: 1.1;
                    }

                        .td-day-num small {
                            font-size: 10px;
                            font-weight: 500;
                            opacity: .85;
                        }

                        .td-day-num span {
                            font-size: 20px;
                        }

                    /* Konum */
                    .td-map-box {
                        position: relative;
                        width: 100%;
                        min-height: 340px;
                        border-radius: 16px;
                        border: 1px solid #e2e8f0;
                        overflow: hidden;
                        background: #eef2f6;
                    }

                        .td-map-box img {
                            display: block;
                            width: 100%;
                            height: auto;
                        }

                    .td-note {
                        background: #fef8e7;
                        border: 1px solid #f5e0a3;
                        color: #8a6414;
                        border-radius: 12px;
                        padding: 18px 20px;
                        font-size: 14px;
                        line-height: 1.7;
                    }

                    /* Yorumlar */
                    .td-alert {
                        border-radius: 12px;
                        padding: 14px 18px;
                        font-size: 14px;
                        font-weight: 600;
                        margin-bottom: 20px;
                    }

                    .td-alert-ok {
                        background: #e8f8f2;
                        border: 1px solid #b7e4d3;
                        color: #0f7a58;
                    }

                    .td-alert-err {
                        background: #fdecec;
                        border: 1px solid #f3c2c2;
                        color: #c23434;
                    }

                    .td-score-head {
                        display: grid;
                        grid-template-columns: 200px 1fr;
                        gap: 26px;
                        background: #f7fafc;
                        border: 1px solid #e6eef3;
                        border-radius: 16px;
                        padding: 24px;
                        margin-bottom: 26px;
                    }

                    .td-score-big {
                        text-align: center;
                    }

                        .td-score-big .lbl {
                            font-size: 12.5px;
                            color: #64748b;
                            margin-bottom: 6px;
                        }

                        .td-score-big .num {
                            font-size: 44px;
                            font-weight: 700;
                            color: #0d1b2a;
                            line-height: 1;
                        }

                        .td-score-big .cnt {
                            font-size: 12.5px;
                            color: #64748b;
                            margin-top: 6px;
                        }

                    .td-bars {
                        display: grid;
                        gap: 10px;
                    }

                    .td-bar-row {
                        display: grid;
                        grid-template-columns: 100px 1fr 34px;
                        align-items: center;
                        gap: 12px;
                        font-size: 13px;
                    }

                    .td-bar {
                        height: 8px;
                        background: #e4ebf0;
                        border-radius: 6px;
                        overflow: hidden;
                    }

                        .td-bar > span {
                            display: block;
                            height: 100%;
                            background: #f0b429;
                            border-radius: 6px;
                        }

                    .td-review {
                        border: 1px solid #e6eef3;
                        border-radius: 14px;
                        padding: 18px 20px;
                        margin-bottom: 12px;
                    }

                    .td-review-top {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        margin-bottom: 8px;
                        gap: 10px;
                        flex-wrap: wrap;
                    }

                    .td-review-name {
                        font-weight: 700;
                        color: #0d1b2a;
                    }

                    .td-review-date {
                        font-size: 12.5px;
                        color: #94a3b8;
                    }

                    .td-review-detail {
                        color: #475569;
                        font-size: 14.5px;
                        line-height: 1.7;
                        margin: 0;
                    }

                    .td-review-scores {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 8px;
                        margin-top: 12px;
                    }

                        .td-review-scores span {
                            background: #f2f6f9;
                            border-radius: 8px;
                            padding: 5px 10px;
                            font-size: 12.5px;
                            color: #64748b;
                        }

                        .td-review-scores b {
                            color: #0d1b2a;
                        }

                    /* Yorum formu */
                    .td-form {
                        border: 1px solid #e6eef3;
                        border-radius: 16px;
                        padding: 24px;
                        margin-top: 30px;
                        background: #fbfdfe;
                    }

                    .td-form-note {
                        font-size: 13.5px;
                        color: #64748b;
                        margin: -6px 0 18px;
                    }

                    .td-field {
                        margin-bottom: 16px;
                    }

                        .td-field label.cap {
                            display: block;
                            font-size: 13.5px;
                            font-weight: 600;
                            color: #334155;
                            margin-bottom: 6px;
                        }

                        .td-field input[type=text],
                        .td-field textarea {
                            width: 100%;
                            border: 1px solid #d9e2ea;
                            border-radius: 10px;
                            padding: 11px 14px;
                            font-size: 14px;
                            font-family: 'DM Sans', sans-serif;
                            color: #1e293b;
                            background: #fff;
                        }

                            .td-field input[type=text]:focus,
                            .td-field textarea:focus {
                                outline: none;
                                border-color: #2d9cdb;
                            }

                        .td-field textarea {
                            min-height: 110px;
                            resize: vertical;
                        }

                    .td-rates {
                        display: grid;
                        grid-template-columns: repeat(2, 1fr);
                        gap: 14px;
                        margin-bottom: 18px;
                    }

                    .td-rate-item {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        gap: 10px;
                        border: 1px solid #e6eef3;
                        border-radius: 12px;
                        padding: 12px 16px;
                        background: #fff;
                    }

                        .td-rate-item .cap {
                            font-size: 13.5px;
                            font-weight: 600;
                            color: #334155;
                        }

                    /* Ters siralama: DOM'da 5'ten 1'e, ekranda 1'den 5'e */
                    .td-rate {
                        display: flex;
                        flex-direction: row-reverse;
                        justify-content: flex-start;
                        gap: 3px;
                    }

                        .td-rate input {
                            position: absolute;
                            opacity: 0;
                            pointer-events: none;
                        }

                        .td-rate label {
                            cursor: pointer;
                            font-size: 22px;
                            line-height: 1;
                            color: #d5dee6;
                            transition: color .15s;
                            margin: 0;
                        }

                        .td-rate input:checked ~ label {
                            color: #f0b429;
                        }

                        .td-rate:hover label {
                            color: #d5dee6;
                        }

                        .td-rate label:hover,
                        .td-rate label:hover ~ label {
                            color: #f0b429;
                        }

                    .td-submit {
                        background: #2d9cdb;
                        color: #fff;
                        border: none;
                        font-weight: 700;
                        font-size: 15px;
                        padding: 13px 30px;
                        border-radius: 12px;
                        cursor: pointer;
                        transition: background .18s;
                    }

                        .td-submit:hover {
                            background: #1a7ab5;
                        }

                    .td-form-error {
                        display: none;
                        color: #c23434;
                        font-size: 13.5px;
                        font-weight: 600;
                        margin-top: 12px;
                    }

                    /* Galeri */
                    .td-gallery {
                        display: grid;
                        grid-template-columns: repeat(3, 1fr);
                        gap: 14px;
                    }

                    .td-shot {
                        position: relative;
                        border-radius: 14px;
                        overflow: hidden;
                        aspect-ratio: 4 / 3;
                        background: #eef2f6;
                    }

                        .td-shot img {
                            position: absolute;
                            inset: 0;
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                            transition: transform .35s;
                        }

                        .td-shot:hover img {
                            transform: scale(1.06);
                        }

                        .td-shot > span.cap {
                            position: absolute;
                            left: 0;
                            right: 0;
                            bottom: 0;
                            padding: 22px 14px 10px;
                            background: linear-gradient(transparent, rgba(0,0,0,.65));
                            color: #fff;
                            font-size: 13px;
                            font-weight: 600;
                        }

                    .td-empty {
                        text-align: center;
                        padding: 50px 20px;
                        color: #94a3b8;
                        font-size: 14.5px;
                    }

                    @@media (max-width: 991px) {
                        .td-hero {
                            grid-template-columns: 1fr;
                        }

                        .td-score-head {
                            grid-template-columns: 1fr;
                        }

                        .td-gallery {
                            grid-template-columns: repeat(2, 1fr);
                        }

                        .td-infocards {
                            grid-template-columns: repeat(2, 1fr);
                        }

                        .td-rates {
                            grid-template-columns: 1fr;
                        }
                    }

                    @@media (max-width: 575px) {
                        .td-gallery {
                            grid-template-columns: 1fr;
                        }

                        .td-infocards {
                            grid-template-columns: 1fr;
                        }
                    }
                </style>

                <div class="td-wrap">

                    <!-- Ust bolum -->
                    <div class="td-hero">
                        <div>
                            <div class="td-cover-box">
                                <div class="td-ph"><i class="bi bi-image"></i></div>
                                @if (!string.IsNullOrWhiteSpace(Model.Tour.CoverImageUrl))
                                {
                                    <img src="@Model.Tour.CoverImageUrl" alt="@Model.Tour.Title"
                                         onerror="this.style.display='none';" />
                                }
                            </div>
                        </div>

                        <div class="td-side">
                            @if (rozetAnahtar != null)
                            {
                                <span class="td-badge">@L[rozetAnahtar]</span>
                            }

                            <h1 class="td-title">@(L[Model.Tour.Title]?.Value ?? Model.Tour.Title)</h1>

                            <div class="td-loc">
                                <i class="bi bi-geo-alt"></i>
                                @(Model.DestinationName != null ? (L[Model.DestinationName]?.Value ?? Model.DestinationName) : L["Tour_NoLocation"].Value)
                            </div>

                            <div class="td-rating" style="margin-bottom:18px;">
                                @Html.Raw(Yildizlar(Model.AverageScore))
                                @if (Model.Reviews.Any())
                                {
                                    <span>@Model.AverageScore.ToString("F1") (@Model.Reviews.Count @L["Tour_ReviewCount"])</span>
                                }
                                else
                                {
                                    <span>@L["Tour_NoReviews"]</span>
                                }
                            </div>

                            <p class="td-price">@Model.Tour.Price.ToString("N0") &#8378;</p>
                            <p class="td-price-sub">@L["Detail_PerPerson"]</p>

                            <ul class="td-facts">
                                <li>
                                    <span class="lbl">@L["Detail_Duration"]</span>
                                    <span class="val">@Model.Tour.DayCount @L["Tour_Days"]</span>
                                </li>
                                <li>
                                    <span class="lbl">@L["Detail_Category"]</span>
                                    <span class="val">@(Model.CategoryName != null ? (L[Model.CategoryName]?.Value ?? Model.CategoryName) : "-")</span>
                                </li>
                                <li>
                                    <span class="lbl">@L["Detail_Capacity"]</span>
                                    <span class="val">@Model.Tour.Capacity @L["Tour_People"]</span>
                                </li>
                                <li>
                                    <span class="lbl">@L["Detail_Reserved"]</span>
                                    <span class="val">@Model.ReservedSeats @L["Tour_People"]</span>
                                </li>
                            </ul>

                            @if (Model.IsFull)
                            {
                                <div class="td-seats td-seats-full">
                                    @L["Detail_Full"]
                                </div>
                            }
                            else
                            {
                                <div class="td-seats td-seats-ok" style="margin-bottom:12px;">
                                    @L["Detail_SeatsLeft", Model.RemainingSeats]
                                </div>

                                <a asp-controller="Reservation" asp-action="CreateReservation" asp-route-id="@Model.Tour.TourId"
                                   class="td-book">
                                    @L["Detail_BookNow"]
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Sekmeler -->
                    <div class="td-tabs">
                        <button type="button" class="td-tab active" data-tab="information">@L["Tab_Information"]</button>
                        <button type="button" class="td-tab" data-tab="tourplan">@L["Tab_TourPlan"]</button>
                        <button type="button" class="td-tab" data-tab="location">@L["Tab_Location"]</button>
                        <button type="button" class="td-tab" data-tab="reviews">@L["Tab_Reviews"] (@Model.Reviews.Count)</button>
                        <button type="button" class="td-tab" data-tab="gallery">@L["Tab_Gallery"] (@Model.TourImages.Count)</button>
                    </div>

                    <!-- Bilgiler -->
                    <div class="td-panel active" id="information">
                        <h3 class="td-h3">@L["Detail_About"]</h3>
                        <p class="td-text">@Model.Tour.Description</p>

                        <div class="td-infocards">
                            <div class="td-infocard">
                                <i class="bi bi-calendar3"></i>
                                <span class="lbl">@L["Detail_Duration"]</span>
                                <span class="val">@Model.Tour.DayCount @L["Tour_Days"]</span>
                            </div>
                            <div class="td-infocard">
                                <i class="bi bi-people"></i>
                                <span class="lbl">@L["Detail_Capacity"]</span>
                                <span class="val">@Model.Tour.Capacity @L["Tour_People"]</span>
                            </div>
                            <div class="td-infocard">
                                <i class="bi bi-tag"></i>
                                <span class="lbl">@L["Tour_Price"]</span>
                                <span class="val">@Model.Tour.Price.ToString("N0") &#8378;</span>
                            </div>
                            <div class="td-infocard">
                                <i class="bi bi-person-check"></i>
                                <span class="lbl">@L["Detail_Reserved"]</span>
                                <span class="val">@Model.ReservedSeats / @Model.Tour.Capacity</span>
                            </div>
                        </div>
                    </div>

                    <!-- Tur programi -->
                    <div class="td-panel" id="tourplan">
                        <h3 class="td-h3">@L["Detail_DayByDay"]</h3>

                        @if (!Model.TourPlans.Any())
                        {
                            <div class="td-empty">@L["Detail_NoPlan"]</div>
                        }
                        else
                        {
                            @foreach (var plan in Model.TourPlans)
                            {
                                <div class="td-day">
                                    <div class="td-day-num">
                                        <small>@L["Detail_Day"]</small>
                                        <span>@plan.DayNumber</span>
                                    </div>
                                    <div>
                                        <h4 style="font-size:16px; font-weight:700; margin:0 0 6px; color:#0d1b2a;">
                                            @plan.Title
                                        </h4>
                                        <p class="td-text" style="margin:0;">@plan.Description</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Konum -->
                    <div class="td-panel" id="location">
                        <h3 class="td-h3">@(Model.DestinationName ?? L["Tab_Location"].Value)</h3>

                        @if (!string.IsNullOrWhiteSpace(Model.Tour.MapLocationImageUrl))
                        {
                            <div class="td-map-box">
                                <div class="td-ph"><i class="bi bi-map"></i></div>
                                <img src="@Model.Tour.MapLocationImageUrl"
                                     alt="@haritaAlt"
                                     onerror="this.style.display='none';" />
                            </div>
                        }
                        else
                        {
                            <div class="td-note">
                                <strong>@L["Detail_MapMissing"]</strong><br />
                                @L["Detail_MapNote"]
                            </div>
                        }
                    </div>

                    <!-- Yorumlar -->
                    <div class="td-panel" id="reviews">

                        @if (!string.IsNullOrWhiteSpace(yorumMesaji))
                        {
                            <div class="td-alert td-alert-ok">
                                <i class="bi bi-check-circle"></i> @yorumMesaji
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(yorumHatasi))
                        {
                            <div class="td-alert td-alert-err">
                                <i class="bi bi-exclamation-circle"></i> @yorumHatasi
                            </div>
                        }

                        @if (!Model.Reviews.Any())
                        {
                            <div class="td-empty">@L["Detail_NoReviewsYet"]</div>
                        }
                        else
                        {
                            <div class="td-score-head">
                                <div class="td-score-big">
                                    <div class="lbl">@L["Detail_AverageScore"]</div>
                                    <div class="num">@Model.AverageScore.ToString("F1")</div>
                                    <div>@Html.Raw(Yildizlar(Model.AverageScore))</div>
                                    <div class="cnt">@Model.Reviews.Count @L["Tour_ReviewCount"]</div>
                                </div>

                                <div class="td-bars">
                                    @foreach (var (etiket, puan) in new[]
                                   {
                                        (L["Score_Guide"].Value, Model.AverageGuideScore),
                                        (L["Score_Accommodation"].Value, Model.AverageAccommodationScore),
                                        (L["Score_Transport"].Value, Model.AverageTransportScore),
                                        (L["Score_Comfort"].Value, Model.AverageComfortScore)
                                    })
                                    {
                                        <div class="td-bar-row">
                                            <span style="color:#64748b; font-weight:600;">@etiket</span>
                                            <div class="td-bar">
                                                <span style="width:@((puan / 5 * 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%;"></span>
                                            </div>
                                            <b>@puan.ToString("F1")</b>
                                        </div>
                                    }
                                </div>
                            </div>

                            @foreach (var yorum in Model.Reviews.OrderByDescending(x => x.ReviewDate))
                            {
                                <div class="td-review">
                                    <div class="td-review-top">
                                        <div>
                                            <div class="td-review-name">@yorum.NameSurname</div>
                                            <div class="td-review-date">@yorum.ReviewDate.ToString("dd MMMM yyyy")</div>
                                        </div>
                                        <div class="td-rating">
                                            @Html.Raw(Yildizlar(yorum.AverageScore))
                                            <b style="color:#0d1b2a;">@yorum.AverageScore.ToString("F1")</b>
                                        </div>
                                    </div>

                                    <p class="td-review-detail">@yorum.Detail</p>

                                    <div class="td-review-scores">
                                        <span>@L["Score_Guide"] <b>@yorum.GuideScore</b></span>
                                        <span>@L["Score_Accommodation"] <b>@yorum.AccommodationScore</b></span>
                                        <span>@L["Score_Transport"] <b>@yorum.TransportScore</b></span>
                                        <span>@L["Score_Comfort"] <b>@yorum.ComfortScore</b></span>
                                    </div>
                                </div>
                            }
                        }

                        <!-- Ziyaretci yorum formu -->
                        <form asp-controller="Review" asp-action="CreateReview" method="post" class="td-form" id="td-review-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TourId" value="@Model.Tour.TourId" />

                            <h3 class="td-h3">@L["Review_FormTitle"]</h3>
                            <p class="td-form-note">@L["Review_FormNote"]</p>

                            <div class="td-field">
                                <label class="cap" for="rv-name">@L["Review_NameSurname"]</label>
                                <input type="text" id="rv-name" name="NameSurname" maxlength="100" required />
                            </div>

                            <div class="td-field">
                                <label class="cap" for="rv-detail">@L["Review_Detail"]</label>
                                <textarea id="rv-detail" name="Detail" maxlength="1000" required></textarea>
                            </div>

                            <div class="td-rates">
                                @foreach (var (alan, kisa, baslik) in new[]
                               {
                                    ("GuideScore", "g", L["Score_Guide"].Value),
                                    ("AccommodationScore", "a", L["Score_Accommodation"].Value),
                                    ("TransportScore", "t", L["Score_Transport"].Value),
                                    ("ComfortScore", "c", L["Score_Comfort"].Value)
                                })
                                {
                                    <div class="td-rate-item">
                                        <span class="cap">@baslik</span>
                                        <div class="td-rate">
                                            @for (int p = 5; p >= 1; p--)
                                            {
                                                var id = $"rv-{kisa}{p}";
                                                <input type="radio" id="@id" name="@alan" value="@p" />
                                                <label for="@id" title="@p">&#9733;</label>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <button type="submit" class="td-submit">@L["Review_Submit"]</button>
                            <div class="td-form-error" id="td-review-error">@L["Review_Invalid"]</div>
                        </form>
                    </div>

                    <!-- Galeri -->
                    <div class="td-panel" id="gallery">
                        <h3 class="td-h3">@L["Detail_TourGallery"]</h3>

                        @if (!Model.TourImages.Any())
                        {
                            <div class="td-empty">@L["Detail_NoPhotos"]</div>
                        }
                        else
                        {
                            <div class="td-gallery">
                                @foreach (var foto in Model.TourImages)
                                {
                                    <div class="td-shot">
                                        <div class="td-ph"><i class="bi bi-image"></i></div>
                                        @if (!string.IsNullOrWhiteSpace(foto.ImageUrl))
                                        {
                                            <img src="@foto.ImageUrl" alt="@foto.Title" onerror="this.style.display='none';" />
                                        }
                                        <span class="cap">@foto.Title</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                </div>

            </main>

            @await Component.InvokeAsync("_TourFooterComponentPartial")

        </div>
    </div>

    <a id="scroll-top" class="button-go"></a>

    <script src="/vitour/app/js/jquery.min.js"></script>
    <script src="/vitour/app/js/bootstrap.min.js"></script>
    <script src="/vitour/app/js/main.js"></script>

    <script>
        (function () {
            var tabs = document.querySelectorAll('.td-tab');

            function sekmeAc(ad) {
                var tab = document.querySelector('.td-tab[data-tab="' + ad + '"]');
                var panel = document.getElementById(ad);
                if (!tab || !panel) return false;

                tabs.forEach(function (t) { t.classList.remove('active'); });
                document.querySelectorAll('.td-panel').forEach(function (p) { p.classList.remove('active'); });
                tab.classList.add('active');
                panel.classList.add('active');
                return true;
            }

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () { sekmeAc(this.dataset.tab); });
            });

            // Yorum gonderiminden sonra #reviews ile donuluyor
            var hash = (window.location.hash || '').replace('#', '');
            if (/^[a-z]+$/.test(hash) && sekmeAc(hash)) {
                document.getElementById(hash).scrollIntoView();
            }

            var form = document.getElementById('td-review-form');
            var hata = document.getElementById('td-review-error');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var alanlar = ['GuideScore', 'AccommodationScore', 'TransportScore', 'ComfortScore'];
                    var eksik = alanlar.some(function (ad) {
                        return !form.querySelector('input[name="' + ad + '"]:checked');
                    });
                    if (eksik) {
                        e.preventDefault();
                        hata.style.display = 'block';
                    }
                });
            }
        })();
    </script>

</body>
</html>
