@model CreateReservationDto

@{
    Layout = null;

    var tour = ViewBag.Tour as GetTourByIdDto;
    int remainingSeats = ViewBag.RemainingSeats ?? 0;
    bool isFull = ViewBag.IsFull ?? false;

    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var maxPerson = Math.Min(50, Math.Max(1, remainingSeats));
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rezervasyon - @tour.Title</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['DM Sans', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#eef7fd', 100: '#d6ecfa', 500: '#2d9cdb', 600: '#1a7ab5', 900: '#0d1b2a' }
                    }
                }
            }
        }
    </script>
</head>
<body class="font-sans bg-slate-100 text-slate-800 min-h-screen">

    <!-- Ust cubuk -->
    <header class="bg-brand-900 text-white">
        <div class="max-w-6xl mx-auto px-5 py-4 flex items-center justify-between">
            <a asp-controller="Tour" asp-action="TourList" class="flex items-center gap-2 font-semibold">
                <span class="w-8 h-8 rounded-lg bg-brand-500 grid place-items-center text-sm">V</span>
                Vitour
            </a>
            <a asp-controller="Tour" asp-action="TourDetail" asp-route-id="@tour.TourId"
               class="text-sm text-slate-300 hover:text-white transition">
                Tur detayına dön
            </a>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-5 py-10">

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-brand-900">Rezervasyon Oluştur</h1>
            <p class="text-slate-500 mt-1">Bilgilerinizi doldurun, rezervasyonunuz onaya gönderilsin.</p>
        </div>

        <div class="grid lg:grid-cols-3 gap-7">

            <!-- Form -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-7">

                    @if (isFull)
                    {
                        <div class="rounded-xl bg-red-50 border border-red-200 text-red-700 px-5 py-4 mb-6">
                            <p class="font-semibold">Bu turun kontenjanı dolmuştur.</p>
                            <p class="text-sm mt-1">Yeni rezervasyon alınamıyor. Diğer turlarımıza göz atabilirsiniz.</p>
                        </div>
                    }

                    @* Kontenjan asimi gibi forma ozel olmayan hatalar *@
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="rounded-xl bg-red-50 border border-red-200 text-red-700 px-5 py-4 mb-6">
                            @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                            {
                                <p class="font-medium">@error.ErrorMessage</p>
                            }
                        </div>
                    }

                    <form asp-controller="Reservation" asp-action="CreateReservation" method="post" class="space-y-5">
                        <input asp-for="TourId" type="hidden" />

                        <div class="grid sm:grid-cols-2 gap-5">
                            <div>
                                <label asp-for="NameSurname" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                    Ad Soyad
                                </label>
                                <input asp-for="NameSurname" maxlength="100"
                                       class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition"
                                       placeholder="Adınız ve soyadınız" />
                                <span asp-validation-for="NameSurname" class="text-red-600 text-xs mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="PersonCount" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                    Kişi Sayısı
                                </label>
                                <input asp-for="PersonCount" type="number" min="1" max="@maxPerson"
                                       class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition" />
                                <span asp-validation-for="PersonCount" class="text-red-600 text-xs mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="Email" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                    E-posta
                                </label>
                                <input asp-for="Email" type="email"
                                       class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition"
                                       placeholder="ornek@eposta.com" />
                                <span asp-validation-for="Email" class="text-red-600 text-xs mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="Phone" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                    Telefon
                                </label>
                                <input asp-for="Phone" type="tel"
                                       class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition"
                                       placeholder="05XX XXX XX XX" />
                                <span asp-validation-for="Phone" class="text-red-600 text-xs mt-1 block"></span>
                            </div>

                            <div>
                                <label asp-for="ReservationDate" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                    Rezervasyon Tarihi
                                </label>
                                <input asp-for="ReservationDate" type="date" min="@minDate"
                                       class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition" />
                                <span asp-validation-for="ReservationDate" class="text-red-600 text-xs mt-1 block"></span>
                            </div>
                        </div>

                        <div>
                            <label asp-for="Note" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                Not <span class="font-normal text-slate-400">(isteğe bağlı)</span>
                            </label>
                            <textarea asp-for="Note" rows="4" maxlength="500"
                                      class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition resize-y"
                                      placeholder="Özel talepleriniz (beslenme tercihi, oda tipi vb.)"></textarea>
                            <span asp-validation-for="Note" class="text-red-600 text-xs mt-1 block"></span>
                        </div>

                        <div class="pt-4 border-t border-slate-200 flex flex-wrap gap-3">
                            <button type="submit"
                                    class="rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold px-6 py-3 text-sm shadow-lg shadow-brand-500/30 transition disabled:opacity-40 disabled:cursor-not-allowed disabled:shadow-none"
                                    disabled="@isFull">
                                Rezervasyonu Tamamla
                            </button>
                            <a asp-controller="Tour" asp-action="TourDetail" asp-route-id="@tour.TourId"
                               class="rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-6 py-3 text-sm transition">
                                Vazgeç
                            </a>
                        </div>

                        <p class="text-xs text-slate-400">
                            Rezervasyonunuz "Onay Bekliyor" durumunda oluşturulur; ekibimiz onayladıktan sonra
                            e-posta ile bilgilendirilirsiniz.
                        </p>
                    </form>
                </div>
            </div>

            <!-- Tur ozeti -->
            <aside>
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden sticky top-6">
                    @if (!string.IsNullOrWhiteSpace(tour.CoverImageUrl))
                    {
                        <img src="@tour.CoverImageUrl" alt="@tour.Title" class="w-full h-44 object-cover"
                             onerror="this.onerror=null;this.src='/vitour/assets/images/page/breakcrumb.jpg';" />
                    }
                    else
                    {
                        <div class="w-full h-44 bg-slate-200 grid place-items-center text-slate-400 text-sm">
                            Görsel bulunmuyor
                        </div>
                    }

                    <div class="p-6">
                        <h2 class="font-bold text-lg text-brand-900 leading-snug">@tour.Title</h2>

                        <dl class="mt-5 space-y-3 text-sm">
                            <div class="flex justify-between">
                                <dt class="text-slate-500">Süre</dt>
                                <dd class="font-semibold">@tour.DayCount gün</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-slate-500">Kişi başı fiyat</dt>
                                <dd class="font-semibold text-brand-500">@tour.Price.ToString("N0") ₺</dd>
                            </div>
                            <div class="flex justify-between">
                                <dt class="text-slate-500">Toplam kapasite</dt>
                                <dd class="font-semibold">@tour.Capacity kişi</dd>
                            </div>
                        </dl>

                        <div class="mt-5 pt-5 border-t border-slate-200">
                            @if (isFull)
                            {
                                <div class="rounded-xl bg-red-50 text-red-700 text-sm font-semibold text-center py-3">
                                    Kontenjan doldu
                                </div>
                            }
                            else
                            {
                                <div class="rounded-xl bg-emerald-50 text-emerald-700 text-sm font-semibold text-center py-3">
                                    Son @remainingSeats kişilik yer kaldı
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </aside>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
