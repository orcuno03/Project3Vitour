@{
    Layout = null;

    var tourTitle = ViewBag.TourTitle as string;
    var personCount = ViewBag.PersonCount as int?;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rezervasyon Alındı</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['DM Sans', 'sans-serif'] },
                    colors: { brand: { 500: '#2d9cdb', 600: '#1a7ab5', 900: '#0d1b2a' } }
                }
            }
        }
    </script>
</head>
<body class="font-sans bg-slate-100 text-slate-800 min-h-screen grid place-items-center px-5 py-14">

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm max-w-lg w-full p-9 text-center">

        <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 grid place-items-center mx-auto mb-6">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h1 class="text-2xl font-bold text-brand-900">Rezervasyonunuz alındı</h1>

        <p class="text-slate-500 mt-3 leading-relaxed">
            <span class="font-semibold text-slate-700">@tourTitle</span> turu için
            @if (personCount.HasValue)
            {
                <span class="font-semibold text-slate-700">@personCount kişilik</span>
            }
            rezervasyon talebiniz oluşturuldu.
        </p>

        <div class="mt-6 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm px-5 py-4 text-left">
            Talebiniz şu anda <strong>Onay Bekliyor</strong> durumunda. Ekibimiz kontenjanı teyit edip
            onayladıktan sonra e-posta ile bilgilendirileceksiniz.
        </div>

        <div class="mt-7 flex flex-wrap gap-3 justify-center">
            <a asp-controller="Tour" asp-action="TourList"
               class="rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold px-6 py-3 text-sm shadow-lg shadow-brand-500/30 transition">
                Diğer turlara göz at
            </a>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                title: 'Tebrikler!',
                text: 'Rezervasyon talebiniz ve onay e-postanız başarıyla gönderildi.',
                icon: 'success',
                confirmButtonColor: '#2d9cdb',
                confirmButtonText: 'Tamam'
            });
        });
    </script>
</body>
</html>
