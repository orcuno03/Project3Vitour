@model CreateCategoryDto

@{
    ViewData["Title"] = "Yeni Kategori";
    Layout = "~/Views/Shared/_TourLayout.cshtml";
}

<div class="section-header">
    <div>
        <h1 class="section-title">Yeni Kategori</h1>
        <p class="section-sub">Turların gruplandığı kategoriyi tanımlayın</p>
    </div>
    <a asp-controller="AdminCategory" asp-action="CategoryList" class="btn-admin btn-ghost-admin">
        <i class="bi bi-arrow-left"></i> Listeye Dön
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body">
        <form method="post">
            <div class="form-grid">

                <div class="form-group-admin full">
                    <label asp-for="CategoryName" class="form-label-admin">Kategori Adı</label>
                    <input asp-for="CategoryName" class="form-control-admin" placeholder="Örn: Kültür Turu" />
                    <span asp-validation-for="CategoryName" class="validation-msg"></span>
                </div>

                <div class="form-group-admin full">
                    <label class="form-label-admin">Durum</label>
                    <div class="switch-row">
                        <div class="form-check form-switch">
                            <input asp-for="CategoryStatus" class="form-check-input" type="checkbox" role="switch" />
                        </div>
                        <span class="cell-muted">Aktif kategoriler sitede görünür.</span>
                    </div>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="btn-admin btn-primary-admin">
                    <i class="bi bi-check-lg"></i> Kaydet
                </button>
                <a asp-controller="AdminCategory" asp-action="CategoryList" class="btn-admin btn-ghost-admin">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
